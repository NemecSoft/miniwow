[gd_resource type="Terrain3DMaterial" load_steps=4 format=3 uid="uid://cm39forestmaterial01"]

; M39：雾中森林专用 Terrain3D 材质（需求 3「场景加材质」· 地形部分）。
; 从 assets/terrain_demo/data/M_terrain.tres 复制，只改视觉参数，demo 原始资源不动。
; 改动点与踩坑记录见同目录 M_forest.md（.tres 不支持 ## 注释，会 Parse Error）。
; 注意 world_background = 0（NONE）：demo 素材里是 2（纯色），从相机下方看
; 会露出一大块蓝色（M39 首版狩猎区截图 m39_2a_hunt.png 的下半屏蓝）。
; terrain_starter.gd 里的 _setup_material 本来想设 NONE，但它从未被调用。

[sub_resource type="Gradient" id="Gradient_vr1m7"]
offsets = PackedFloat32Array(0.2, 1)
colors = PackedColorArray(1, 1, 1, 1, 0, 0, 0, 1)

[sub_resource type="FastNoiseLite" id="FastNoiseLite_d8lcj"]
