; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="MiniWoW"
config/description="MiniWoW - a mini World of Warcraft built on the Godot 3D multiplayer template."
config/tags=PackedStringArray("3d", "network")
run/main_scene="res://scenes/level/level.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[autoload]

LanguageManager="*res://scripts/autoload/language_manager.gd"
Network="*res://scripts/autoload/network.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
CombatMath="*res://scripts/autoload/combat_math.gd"
SkillDatabase="*res://scripts/autoload/skill_database.gd"
MonsterDatabase="*res://scripts/autoload/monster_database.gd"
LevelData="*res://scripts/progression/level_data.gd"
QuestDatabase="*res://scripts/autoload/quest_database.gd"
ClassDatabase="*res://scripts/autoload/class_database.gd"
SfxManager="*res://scripts/autoload/sfx_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[global_group]

Players="A group containing all of the player nodes"

[gui]

theme/custom_font="res://assets/fonts/Kurland.ttf"

